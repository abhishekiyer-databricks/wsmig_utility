{
  "name": "wsmig - import",
  "description": "Workspace Migration: import only (04_Import). dry_run is a normal param here for isolated runs / retries.",
  "run_as": {
    "service_principal_name": "{{RUN_AS_SP}}"
  },
  "max_concurrent_runs": 1,
  "tags": {
    "wsmig": "true"
  },
  "tasks": [
    {
      "task_key": "import",
      "notebook_task": {
        "notebook_path": "{{REPO_PATH}}/notebooks/04_Import",
        "source": "WORKSPACE",
        "base_parameters": {
          "connectivity_mode": "",
          "source_workspace_id": "",
          "staging_location": "",
          "run_id": "",
          "source_workspace_url": "",
          "source_sp_client_id": "",
          "source_sp_secret_scope": "",
          "source_sp_secret_key": "",
          "spn_secret_value": "",
          "dry_run": "true",
          "state_catalog": "",
          "state_schema": "",
          "import_assets": "all",
          "retry_mode": "off",
          "preflight_enforce": "true",
          "force_full_import": "false",
          "allow_deletes": "false",
          "library_force_start_clusters": "false",
          "workspace_home_backup": "true",
          "workspace_home_backup_root": "/Users_Backup",
          "account_id": "",
          "user_domain_mapping": "",
          "user_id_mapping": "",
          "pause_job_schedules": "true"
        }
      }
    }
  ]
}
